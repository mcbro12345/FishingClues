<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>FishingClues</AssemblyName>
    <Version>1.6.0.0</Version>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../vendor/KamiToolKit/KamiToolKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="FishingClues.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="FishConditions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="GATHERBUDDY_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TEAMCRAFT_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../AI-GENERATED-NOTICE.md" Link="AI-GENERATED-NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- KamiToolKit copies its whole Assets folder (color-picker textures) and
       its XML doc-comments file into every project that references it. This
       plugin never uses the color picker, and the doc comments are IDE-only
       (Dalamud never reads them), so both are dropped before packaging. -->
  <Target Name="RemoveUnusedKamiToolKitOutput" BeforeTargets="DefaultDalamudPackagerRelease;DefaultDalamudPackagerDebug">
    <RemoveDir Directories="$(OutDir)Assets" Condition="Exists('$(OutDir)Assets')" />
    <Delete Files="$(OutDir)KamiToolKit.xml" Condition="Exists('$(OutDir)KamiToolKit.xml')" />
  </Target>
</Project>
