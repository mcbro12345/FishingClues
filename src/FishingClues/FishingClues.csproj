<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>FishingClues</AssemblyName>
    <Version>3.20.25.0</Version>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../vendor/KamiToolKit/KamiToolKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="FishingClues.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="FishConditions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="JournalButtonReference.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="GATHERBUDDY_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TEAMCRAFT_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../AI-GENERATED-NOTICE.md" Link="AI-GENERATED-NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- KamiToolKit copies its whole Assets folder (color-picker textures) into
       every project that references it, whether or not that project uses the
       color picker. This plugin doesn't, so drop it before packaging. -->
  <Target Name="RemoveUnusedKamiToolKitAssets" BeforeTargets="DefaultDalamudPackagerRelease;DefaultDalamudPackagerDebug">
    <RemoveDir Directories="$(OutDir)Assets" Condition="Exists('$(OutDir)Assets')" />
  </Target>
</Project>
